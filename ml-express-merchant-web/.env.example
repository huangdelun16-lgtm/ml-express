# 本地开发：复制为 .env.local 后填写（不要提交 .env.local）
#   cp .env.example .env.local
#
# Netlify：Site → Environment variables
#   · 前端（参与 react-scripts build 的须以 REACT_APP_ 开头，Build 时注入）
#   · Functions（仅服务端，勿加 REACT_APP_ 前缀；名称如下）

# ----- 前端（必配）-----
REACT_APP_SUPABASE_URL=https://你的项目.supabase.co
REACT_APP_SUPABASE_ANON_KEY=你的_anon_公钥

# 地图（可选）
# REACT_APP_GOOGLE_MAPS_API_KEY=

# ----- Netlify Functions（同一站点中配置；邮件/短信验证码、对账单发信等）-----
# 与 Functions 中代码一致，常用项：
# SUPABASE_SERVICE_ROLE=        # 推荐：服务端用；勿暴露给浏览器
# REACT_APP_SUPABASE_URL=       # Functions 会读同名变量；与上一致即可
# REACT_APP_SUPABASE_ANON_KEY=  # 无 service role 时的回退
# TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN= / TWILIO_PHONE_NUMBER= 或 TWILIO_MESSAGING_SERVICE_SID=
# GMAIL_USER= / GMAIL_APP_PASSWORD=   # send-email-code、send-statement
# ALLOWED_ORIGINS=              # 可选，CORS；多个逗号分隔
# ALLOW_DEV_SMS_CODE=           # 非生产勿开
