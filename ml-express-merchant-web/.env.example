# 本地开发：复制本文件为 .env.local 后填写（不要提交 .env.local）
# cp .env.example .env.local
#
# 浏览器客户端走 Cloudflare 反代（缅甸 ISP 拦截 *.supabase.co）。
# Netlify Functions 使用服务端 SUPABASE_URL，不要改成下面这个值。

REACT_APP_SUPABASE_URL=https://db.market-link-express.com
REACT_APP_SUPABASE_ANON_KEY=你的_anon_公钥

# 地图（可选，未配置则地图相关功能不可用）
# REACT_APP_GOOGLE_MAPS_API_KEY=
