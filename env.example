# ML Express Environment Configuration
# Copy this file to .env and fill in your actual values

# Google Maps API Key
# Get your API key from: https://console.cloud.google.com/apis/credentials
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Public / browser / app clients — Cloudflare proxy (Myanmar ISPs block *.supabase.co)
REACT_APP_SUPABASE_URL=https://ml-supabase-proxy.huangdelun16.workers.dev
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Mobile App Configuration (for Expo)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
EXPO_PUBLIC_SUPABASE_URL=https://ml-supabase-proxy.huangdelun16.workers.dev
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-side only (Netlify Functions, operator scripts). Do NOT point this at workers.dev.
# SUPABASE_URL=https://uopkyuluxnrewvlmutam.supabase.co

# Instructions:
# 1. Copy this file to .env
# 2. Replace the placeholder values with your actual API keys
# 3. Never commit the .env file to version control
# 4. For Netlify deployment, add these variables in Site Settings > Environment Variables
#    - REACT_APP_SUPABASE_URL = https://ml-supabase-proxy.huangdelun16.workers.dev  (browser)
#    - SUPABASE_URL = https://uopkyuluxnrewvlmutam.supabase.co     (functions)
