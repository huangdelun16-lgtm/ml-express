{
  "name": "market-link-express-mobile",
  "version": "2.5.1",
  "description": "MARKET LINK STAFF - 缅甸专业快递骑手端",
  "main": "index.ts",
  "scripts": {
    "sync:shared": "node ../shared/sync.mjs --out services/_shared",
    "prestart": "npm run sync:shared",
    "start": "expo start",
    "android": "expo run:android",
    "android:setup": "./run-android.sh",
    "ios": "expo run:ios",
    "build:aab": "npx --yes eas-cli@latest build --platform android --profile production --clear-cache",
    "build:apk": "npx --yes eas-cli@latest build --platform android --profile apk",
    "eas-build-post-install": "chmod -R a+x node_modules/hermes-compiler/hermesc node_modules/react-native/sdks/hermesc 2>/dev/null || true"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@sentry/react-native": "~8.28.0",
    "@supabase/supabase-js": "^2.58.0",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.18",
    "expo-battery": "~58.0.3",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-notifications": "~58.1.6",
    "expo-sharing": "~58.0.20",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-task-manager": "~58.0.12",
    "expo-updates": "~58.0.18",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-maps": "1.29.11",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "dotenv": "^17.2.3",
    "typescript": "~6.0.3"
  },
  "private": true
}
