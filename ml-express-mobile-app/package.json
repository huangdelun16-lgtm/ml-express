{
  "name": "market-link-express-mobile",
  "version": "2.5.0",
  "description": "MARKET LINK STAFF - 缅甸专业快递骑手端",
  "main": "index.ts",
  "scripts": {
    "sync:shared": "node ../shared/sync.mjs --out services/_shared",
    "prestart": "npm run sync:shared",
    "start": "expo start",
    "android": "expo run:android",
    "android:setup": "./run-android.sh",
    "ios": "expo run:ios",
    "build:aab": "npx --yes eas-cli@latest build --platform android --profile production --clear-cache",
    "build:apk": "npx --yes eas-cli@latest build --platform android --profile apk",
    "eas-build-post-install": "chmod -R a+x node_modules/hermes-compiler/hermesc node_modules/react-native/sdks/hermesc 2>/dev/null || true"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.58.0",
    "expo": "~57.0.20",
    "expo-asset": "~57.0.16",
    "expo-battery": "~57.0.2",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image-picker": "~57.0.16",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.16",
    "expo-notifications": "~57.0.17",
    "expo-sharing": "~57.0.18",
    "expo-speech": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.16",
    "expo-updates": "~57.0.21",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "babel-preset-expo": "~57.0.0",
    "@types/react": "~19.2.4",
    "dotenv": "^17.2.3",
    "typescript": "~6.0.3"
  },
  "private": true
}
