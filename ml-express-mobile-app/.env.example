# 复制为 .env 后填写（勿提交 .env）。EAS 构建：在 Expo 控制台为项目配置同名 Environment variables / Secrets。
# 文档：https://docs.expo.dev/guides/environment-variables/

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_NETLIFY_URL=https://admin-market-link-express.netlify.app
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# 发往骑手的 Expo 推送请在 data 中包含 packageId（或 package_id），便于点击通知直达包裹详情。
# 示例：{ "packageId": "<uuid>", "type": "new_order" }
