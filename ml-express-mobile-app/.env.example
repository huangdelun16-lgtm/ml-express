# 复制为 .env 后本地填写（.env 勿提交 Git）
# STAFF App 走 Cloudflare 反代（缅甸 ISP 拦截 *.supabase.co）
# app.json extra.supabaseUrl 与 EAS 的 EXPO_PUBLIC_SUPABASE_URL 也会打进包
EXPO_PUBLIC_SUPABASE_URL=https://db.market-link-express.com
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 可选
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# EXPO_PUBLIC_NETLIFY_URL=https://admin-market-link-express.com
