# Production native builds rewrite https://uopkyuluxnrewvlmutam.supabase.co -> https://mlexpress-merchants.com/__sb (see nativeSupabaseUrl.ts).
# Local npx expo start uses the value below as-is. For Myanmar WiFi testing in Expo Go, set EXPO_PUBLIC_SUPABASE_URL to https://mlexpress-merchants.com/__sb.
# 复制为 .env 后本地填写（.env 勿提交 Git）
# Supabase：Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Maps / Places：本地 .env 或 EAS Secrets，勿写入 app.json
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-key
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your-places-key

# 商家登录校验（Netlify merchant-password）
# EXPO_PUBLIC_NETLIFY_URL=https://admin-market-link-express.netlify.app
