# Native App 会把 *.supabase.co 改写成 https://mlexpress-merchants.com/__sb/（缅甸网络打不通 supabase.co）。
# 只有本机 VPN 能直连时才设 EXPO_PUBLIC_SUPABASE_DIRECT=1。
# 复制为 .env 后本地填写（.env 勿提交 Git）
# Supabase：Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Maps / Places：本地 .env 或 EAS Secrets，勿写入 app.json
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-key
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your-places-key

# 商家登录校验（优先走缅甸可达的 mlexpress-merchants.com/merchant-password）
# EXPO_PUBLIC_NETLIFY_URL=https://mlexpress-merchants.com
