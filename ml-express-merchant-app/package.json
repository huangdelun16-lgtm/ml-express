{
  "name": "ml-express-merchant-app",
  "version": "2.5.5",
  "main": "index.js",
  "scripts": {
    "sync:shared": "node ../shared/sync.mjs --out src/services/_shared",
    "prestart": "npm run sync:shared",
    "start": "expo start",
    "start:offline": "EXPO_OFFLINE=1 expo start --offline",
    "start:normal": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "npm run sync:shared && npx expo export --platform web",
    "build:ios": "eas build --platform ios --profile production --non-interactive",
    "build:ios:local": "eas build --platform ios --profile production --local",
    "download:ios": "eas build:download --platform ios --latest"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@supabase/supabase-js": "^2.58.0",
    "crypto-js": "^4.2.0",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.18",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-media-library": "~58.0.12",
    "expo-notifications": "~58.1.6",
    "expo-print": "~58.0.7",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.18",
    "qrcode": "^1.5.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-ble-plx": "^3.5.1",
    "react-native-maps": "1.29.11",
    "react-native-qrcode-svg": "^6.3.2",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "babel-preset-expo": "~58.0.0",
    "@types/crypto-js": "^4.2.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~19.3.0",
    "eas-cli": "^16.28.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
