# Admin Web 本地：复制为 .env.local 后填写（不要提交 .env.local）
# Netlify：Site → Environment variables（Build 时注入，须以 REACT_APP_ 开头才会进前端包）

# 必配
REACT_APP_SUPABASE_URL=https://你的项目.supabase.co
REACT_APP_SUPABASE_ANON_KEY=你的_anon_公钥

# 地图
REACT_APP_GOOGLE_MAPS_API_KEY=

# 可选（有则尽量配置，生产见代码说明）
# REACT_APP_JWT_SECRET=
# REACT_APP_LOG_LEVEL=
# REACT_APP_NETLIFY_BASE_URL=https://你的-admin-域名.netlify.app
# REACT_APP_ORDER_CONFIRMATION_ENDPOINT=

# Netlify Functions 仅在服务端，在 Netlify 中单独配置，勿加 REACT_APP_ 前缀
# 例：SUPABASE_URL、SUPABASE_SERVICE_ROLE、TWILIO_*、GMAIL_USER、GMAIL_APP_PASSWORD 等，见 netlify/functions/*.js
