{
  "name": "ml-express-client",
  "version": "2.8.4",
  "main": "index.js",
  "scripts": {
    "sync:shared": "node ../shared/sync.mjs --out src/services/_shared",
    "prestart": "npm run sync:shared",
    "prebuild:web": "npm run sync:shared",
    "start": "expo start",
    "start:offline": "EXPO_OFFLINE=1 expo start --offline",
    "start:normal": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "npm run sync:shared && npx expo export --platform web",
    "build:apk": "eas build --platform android --profile apk",
    "build:apk:local": "eas build --platform android --profile apk --local",
    "build:aab": "eas build --platform android --profile production --non-interactive",
    "build:ios": "eas build --platform ios --profile production --non-interactive",
    "build:ios:local": "eas build --platform ios --profile production --local",
    "download:ios": "eas build:download --platform ios --latest",
    "download:aab": "eas build:download --platform android --latest",
    "build:apk:gradle": "cd android && ./gradlew assembleRelease",
    "download:apk": "eas build:download --platform android --latest",
    "eas-build-post-install": "chmod -R a+x node_modules/hermes-compiler/hermesc node_modules/react-native/sdks/hermesc 2>/dev/null || true"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@expo-google-fonts/noto-sans-myanmar": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@supabase/supabase-js": "^2.58.0",
    "expo": "~57.0.20",
    "expo-asset": "~57.0.16",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.16",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.16",
    "expo-media-library": "~57.0.4",
    "expo-notifications": "~57.0.17",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "eas-cli": "^16.28.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
