{
  "name": "ml-express-inventory-app",
  "version": "2.3.2",
  "main": "index.js",
  "private": true,
  "scripts": {
    "sync:shared": "node -e \"console.log('inventory-app: no shared sync')\"",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:ios": "eas build --platform ios --profile production --non-interactive",
    "build:ios:local": "eas build --platform ios --profile production --local",
    "build:ios:preview": "eas build --platform ios --profile preview --non-interactive",
    "download:ios": "eas build:download --platform ios --latest",
    "build:apk": "eas build --platform android --profile apk --non-interactive",
    "build:apk:local": "eas build --platform android --profile apk --local",
    "download:apk": "eas build:download --platform android --latest",
    "build:aab": "eas build --platform android --profile production",
    "deploy:inventory-login": "cd .. && supabase functions deploy inventory-store-login --project-ref uopkyuluxnrewvlmutam",
    "deploy:inventory-change-password": "cd .. && supabase functions deploy inventory-change-password --project-ref uopkyuluxnrewvlmutam",
    "deploy:inventory-clear-test-data": "cd .. && supabase functions deploy inventory-clear-test-data --project-ref uopkyuluxnrewvlmutam",
    "deploy:inventory-functions": "npm run deploy:inventory-login && npm run deploy:inventory-change-password",
    "deploy:inventory-db": "cd .. && supabase db push --linked"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-myanmar": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@supabase/supabase-js": "^2.108.1",
    "expo": "^58.0.0",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-media-library": "~58.0.12",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.18",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-ble-plx": "^3.5.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
