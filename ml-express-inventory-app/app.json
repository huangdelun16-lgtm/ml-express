{
  "expo": {
    "name": "ML Inventory",
    "slug": "ml-express-inventory",
    "version": "1.6.0",
    "scheme": "ml-express-inventory",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "description": "Business logistics app for transit stations: inbound stock, packing, truck loading, hub receive, barcode scanning, and Supabase-backed inventory. Download from the App Store and sign in with your station store code.",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mlexpress.inventory",
      "buildNumber": "12",
      "infoPlist": {
        "NSCameraUsageDescription": "ML Inventory uses the camera to scan barcodes on packages and inventory labels at transit stations.",
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.mlexpress.inventory",
      "versionCode": 12,
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ML Inventory to use the camera to scan barcodes on packages and inventory labels."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "d125c924-b3da-476d-a176-8fa3117bd2ad"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d125c924-b3da-476d-a176-8fa3117bd2ad"
    }
  }
}
