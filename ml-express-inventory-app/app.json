{
  "expo": {
    "name": "ML Inventory",
    "slug": "ml-express-inventory",
    "version": "1.0.0",
    "scheme": "ml-express-inventory",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "description": "MARKET LINK 中转站库存管理：入库、打包、装车出库与条码标签打印（中转站合伙店铺登录）。",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mlexpress.inventory",
      "infoPlist": {
        "NSCameraUsageDescription": "扫描商品条码需要使用相机。",
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.mlexpress.inventory",
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "扫描商品条码需要使用相机"
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
