# 本地开发：复制本文件为 .env.local 后填写（不要提交 .env.local）
# cp .env.example .env.local
#
# 变量值与 Netlify 站点 Settings → Environment variables 中一致即可。

REACT_APP_SUPABASE_URL=https://你的项目.supabase.co
REACT_APP_SUPABASE_ANON_KEY=你的_anon_公钥

# Functions（merchant-apply 等）：Netlify 上配置 SUPABASE_SERVICE_ROLE 或 SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_SERVICE_ROLE=

# 联系我们 / 下载：App Store 与 Google Play 完整链接（Netlify 与本地构建前填写，未设置则页面上不显示对应按钮）
# 示例：REACT_APP_CLIENT_APP_IOS_URL=https://apps.apple.com/app/id123456789
# 示例：REACT_APP_CLIENT_APP_ANDROID_URL=https://play.google.com/store/apps/details?id=com.example.client
# REACT_APP_CLIENT_APP_IOS_URL=
# REACT_APP_CLIENT_APP_ANDROID_URL=
# REACT_APP_MERCHANT_APP_IOS_URL=
# REACT_APP_MERCHANT_APP_ANDROID_URL=
# 骑手端（MARKET LINK STAFF，包名 com.mlexpress.courier）
# 未填 ANDROID 时，联系我们页默认使用 Google Play：play.google.com/.../id=com.mlexpress.courier
# 若 Play 控制台给出的完整链接不同，请用下面变量覆盖
# REACT_APP_RIDER_APP_IOS_URL=https://apps.apple.com/app/id你的id
REACT_APP_RIDER_APP_ANDROID_URL=https://play.google.com/store/apps/details?id=com.mlexpress.courier
